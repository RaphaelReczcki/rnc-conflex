# Copie para .env e preencha. Nunca versione o .env.

# --- Banco de dados (PostgreSQL) ---
# Neon: use a URL "pooled" (host com -pooler) para a aplicação
# e a URL direta para migrations e seed.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/rnc?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/rnc?sslmode=require"
# PostgreSQL local sem Docker (npm run dev:local ou npm run db:local):
# BANCO_LOCAL_SENHA="gere-uma-senha-longa"
# DATABASE_URL="postgresql://rnc:MESMA_SENHA@localhost:54320/rnc"
# DIRECT_URL="postgresql://rnc:MESMA_SENHA@localhost:54320/rnc"
# Docker local (docker compose up -d), se preferir:
# DATABASE_URL="postgresql://rnc:TROQUE_ESTA_SENHA@localhost:5432/rnc"
# DIRECT_URL="postgresql://rnc:TROQUE_ESTA_SENHA@localhost:5432/rnc"

# Senha do Postgres do docker-compose.yml (só para o banco local)
POSTGRES_PASSWORD="TROQUE_ESTA_SENHA"

# --- Seed: usuário de gestão para teste ---
SEED_GESTAO_NOME="Gestão da Qualidade"
SEED_GESTAO_EMAIL="qualidade@conflex.com.br"
# Mínimo de 12 caracteres. O sistema pede troca no primeiro acesso.
SEED_GESTAO_SENHA=""

# --- Acesso ---
# Domínios de e-mail aceitos ao incluir pessoas (separados por vírgula)
EMAIL_DOMINIOS_PERMITIDOS="conflex.com.br"
# Duração da sessão de login, em horas
SESSAO_HORAS="12"
# Endereço público do sistema, usado nos links de convite (ex.: https://rnc.conflex.com.br).
# Em desenvolvimento pode ficar vazio: o sistema usa o endereço da requisição.
APP_URL=""

# --- Testes de integração ---
# Banco SÓ para testes (ex.: um branch do Neon). Os testes gravam dados nele.
# Para testar sem configurar nada, use: npm run test:integracao:local
TEST_DATABASE_URL=""

# --- E-mails (Microsoft 365 / Graph) --- veja docs/microsoft-365-envio.md
# arquivo (grava em .emails/, padrão no desenvolvimento), graph (padrão em produção) ou desligado
EMAIL_MODO="arquivo"
EMAIL_REMETENTE="rnc@conflex.com.br"
M365_TENANT_ID=""
M365_CLIENT_ID=""
# Segredo do app no Entra ID. Só no .env/Vercel, nunca no código.
M365_CLIENT_SECRET=""

# Segredo que o Vercel Cron envia para disparar as rotinas (gere um valor longo e aleatório)
CRON_SECRET=""
